{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#151426",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "one.guppyguide.caweth",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "versionCode": 9
    },
    "extra": {
      "warning": "Independent community app for a self-deployed CAW instance. Not operated by, affiliated with, or endorsed by the official CAW team."
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "one.guppyguide.caweth",
      "supportsTablet": false
    },
    "name": "CAW — Ethereum Edition",
    "orientation": "portrait",
    "owner": "guppy9180s-team",
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use biometrics to unlock CAW — Ethereum Edition."
        }
      ]
    ],
    "slug": "eth-caw-app",
    "version": "0.1.8"
  }
}